# --- Server ---
PORT=4000
NODE_ENV=development

# MySQL connection string used by Prisma.
# Use the database you created: CREATE DATABASE society_maintenance ...
DATABASE_URL="mysql://root:password@127.0.0.1:3306/society_maintenance"

# Auth
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Society (multi-society app; societies are created in-app, no name needed here)

# Razorpay (optional). Leave blank to run in Demo/Mock payment mode.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

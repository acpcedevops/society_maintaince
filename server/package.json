  "version": "1.0.0",
  "description": "Neev Plaza Society maintenance, expenses, OCR and audit API",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",

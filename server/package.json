    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.1",
    "prisma": "^5.22.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "zod": "^3.23.8"
  }
